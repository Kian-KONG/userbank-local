# =============================================================================
# userbank-local — laptop-only (M4 / GPU workstation)
# Do NOT copy to production servers.
# =============================================================================

# Embed must match production userbank-rag / API import
# (Qwen3-Embedding-0.6B-Q8_0.gguf, dim 1024). Empty EMBED_BASE_URL uses
# the rag sidecar on :8760. Do not use DeepRead 8B (8756) for SSH import.
EMBED_BASE_URL=
EMBED_API_KEY=local
EMBEDDING_MODEL=qwen3-embedding:0.6b
VECTOR_STORE_DIMENSION=1024

# Optional userbank-rag sidecar (vision + fallback embed)
RAG_SERVICE_URL=http://127.0.0.1:8760
RAG_INTERNAL_SECRET=

# Deck synthesizer (text-only, after per-page vision)
LLM_API_URL=https://aigc.bosch.com.cn/llmservice/api/v1/chat/completions
LLM_API_KEY=
LLM_SYNTH_MODEL=qwen3.7-max

SURVEY_ORG_ID=local-dev-eb

SSH_TARGET=deploy@your-ecs-host
IMPORT_STAGING_DIR=/data/import-staging
# Runs on the ECS host after rsync. Override if the API container name differs.
REMOTE_IMPORT_CMD=docker exec userbank-prod-app-1 node dist/scripts/import-staging-bundle.js --job ${JOB_ID}

MINERU_DIR=
DEEPREAD_DIR=
MINERU_PYTHON=
DEEPREAD_PYTHON=
MINERU_BACKEND=vlm-engine
MINERU_EFFORT=high
MINERU_API_URL=http://127.0.0.1:8757
MINERU_MODEL_SOURCE=local
# 128 fits MinerU's 64-page window (2 windows) on a 36GB Mac without
# resubmitting the PDF every 50 pages. Lower this if a huge scan OOMs.
MINERU_PAGE_CHUNK_SIZE=128
# Keep both on for mixed PDFs (papers, patents, reports). Set
# MINERU_FORMULA=false for text/table-only files with no math.
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_TASK_TIMEOUT_SECONDS=7200

UB_LOCAL_HOST=127.0.0.1
UB_LOCAL_PORT=8780
UB_LOCAL_WORK_DIR=./output
