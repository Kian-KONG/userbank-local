# =============================================================================
# userbank-local — laptop-only (M4 / GPU workstation)
# Do NOT copy to production servers.
# =============================================================================

RAG_SERVICE_URL=http://127.0.0.1:8760
RAG_INTERNAL_SECRET=
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must match prod/laptop rag: Qwen3-Embedding-0.6B-Q8_0.gguf (via userbank-rag)
VECTOR_STORE_DIMENSION=1024
# Empty EMBED_BASE_URL uses the rag sidecar on :8760.
EMBED_BASE_URL=
EMBED_API_KEY=local

USERBANK_API_URL=http://127.0.0.1:3000
SURVEY_ORG_ID=local-dev-eb
SURVEY_IMPORT_SECRET=

# Large-file rsync to production
SSH_TARGET=deploy@your-ecs-host
IMPORT_STAGING_DIR=/data/import-staging
UPLOAD_RSYNC_MIN_BYTES=52428800
BUNDLE_SHARD_MAX_BYTES=83886080

# Deck synthesizer + optional Excel column labels (after per-page vision)
LLM_API_URL=https://aigc.bosch.com.cn/llmservice/api/v1/chat/completions
LLM_API_KEY=
LLM_SYNTH_MODEL=qwen3.8-max
# Optional: send sheet headers + sample rows to LLM_SYNTH_MODEL for column labels
EXCEL_LLM_COLUMNS=false

# Sibling MinerU (PDF / Word-via-PDF). PPT decks use LibreOffice + rag vision.
MINERU_DIR=
MINERU_PYTHON=
MINERU_BACKEND=vlm-engine
MINERU_EFFORT=high
MINERU_API_URL=http://127.0.0.1:8757
MINERU_MODEL_SOURCE=local
MINERU_PAGE_CHUNK_SIZE=128
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_TASK_TIMEOUT_SECONDS=7200

# FastAPI bind (localhost only)
UB_LOCAL_HOST=127.0.0.1
UB_LOCAL_PORT=8780
UB_LOCAL_WORK_DIR=./output
