# =============================================================================
# userbank-local — laptop-only (M4 / GPU workstation)
# Do NOT copy to production servers.
# =============================================================================

RAG_SERVICE_URL=http://127.0.0.1:8760
RAG_INTERNAL_SECRET=
EMBEDDING_MODEL=qwen3-embedding:0.6b
VECTOR_STORE_DIMENSION=1024

USERBANK_API_URL=http://127.0.0.1:3000
SURVEY_ORG_ID=local-dev-eb
SURVEY_IMPORT_SECRET=

# Large-file rsync to production
SSH_TARGET=deploy@your-ecs-host
IMPORT_STAGING_DIR=/data/import-staging
UPLOAD_RSYNC_MIN_BYTES=52428800
BUNDLE_SHARD_MAX_BYTES=83886080

# Sibling GPU tools (defaults: ../MinerU, ../DeepRead)
MINERU_DIR=
DEEPREAD_DIR=
MINERU_PYTHON=python3
MINERU_BACKEND=vlm-http-client
MINERU_API_URL=http://127.0.0.1:8757

# FastAPI/Rust bind (localhost only)
UB_LOCAL_HOST=127.0.0.1
UB_LOCAL_PORT=8780
UB_LOCAL_WORK_DIR=./output
